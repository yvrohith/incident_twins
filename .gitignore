# This folder also holds a private author delivery. Only the reviewed public
# top-level files below belong in Git. Add new public entry points deliberately.
/*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE
!/CHECKSUMS.txt
!/PUBLIC_MANIFEST.json
!/verify_public_repo.py
!/package_source.py
!/TITLE_AND_ABSTRACT.txt
!/Incident_Twins_Rohith_YV.pdf
!/Incident_Twins_Rohith_YV.docx
!/judge/

# Keep the checked replay source, instructions and one reviewed judge archive.
/judge/*
!/judge/QUICKSTART.md
!/judge/judge_artifact/
!/judge/Incident_Twins_Judge_Artifact.zip

# Private author/review records and their original whole-delivery inventory.
/author_records/
/FILE_MANIFEST.json
/verify_delivery.py

# macOS Finder, resource forks and filesystem metadata, at every depth.
.DS_Store
.DS_Store?
._*
__MACOSX/
.AppleDouble/
.LSOverride
.Spotlight-V100/
.Trashes/
.fseventsd/
.TemporaryItems/
.VolumeIcon.icns

# Credentials, local environment files and private service/tool configuration.
.env
.env.*
.envrc
.netrc
.git-credentials
.gitconfig
.npmrc
.pypirc
pip.conf
.bash_history
.zsh_history
.python_history
.sqlite_history
.aws/
.azure/
.config/
.gcloud/
.kube/
.ssh/
.codex/
.agents/
.mcp.json
mcp.json
*.local.json
*.local.toml
*.local.yaml
*.local.yml
*.local.ini
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
credentials.json
credentials.yaml
credentials.yml
secrets.json
secrets.yaml
secrets.yml
service-account*.json
application_default_credentials.json
*.kdbx
.vault_pass
terraform.tfstate*
*.tfvars

# Installed environments, Python caches, test/build output and editor state.
.venv/
.venv*/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/
*.egg-info/
node_modules/
.idea/
.vscode/
*.swp
*.swo
*~
~$*
*.orig
*.rej

# New replay outputs, logs and private database/sink files are not fixtures.
judge-results*/
control-results*/
outputs/
results/
logs/
tmp/
temp/
*.log
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*-wal
*-shm
journal-provenance.json
original-provenance.json
direct-query-provenance.json

# Do not accidentally add author bundles or unrelated working documents.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.pdf
*.docx
!/Incident_Twins_Rohith_YV.pdf
!/Incident_Twins_Rohith_YV.docx
!/judge/Incident_Twins_Judge_Artifact.zip

# Scientific JSON inputs, expected answers, runtime_policy.json, dependency
# reference locks and the nested judge file_manifest.json remain included.
